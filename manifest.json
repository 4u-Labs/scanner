{
    "id": "docscan-pro-pwa",
    "name": "DocScan Pro",
    "short_name": "DocScan",
    "description": "Scanner de documentos profissional - Digitalize, edite e organize seus documentos",
    "start_url": "./",
    "display": "standalone",
    "background_color": "#0d0d14",
    "theme_color": "#1a1a2e",
    "orientation": "portrait-primary",
    "scope": "./",
    "lang": "pt-BR",
    "categories": ["productivity", "utilities", "business"],
    "icons": [
        {
            "src": "icon-192x192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icon-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icon-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "shortcuts": [
        {
            "name": "Escanear Documento",
            "short_name": "Escanear",
            "description": "Iniciar nova digitalização",
            "url": "./?action=scan",
            "icons": [
                {
                    "src": "icon-192x192.png",
                    "sizes": "192x192",
                    "type": "image/png"
                }
            ]
        },
        {
            "name": "Meus Documentos",
            "short_name": "Documentos",
            "description": "Ver todos os documentos",
            "url": "./?view=documents",
            "icons": [
                {
                    "src": "icon-192x192.png",
                    "sizes": "192x192",
                    "type": "image/png"
                }
            ]
        }
    ],
    "related_applications": [],
    "prefer_related_applications": false,
    "share_target": {
        "action": "./",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "files": [
                {
                    "name": "images",
                    "accept": ["image/*"]
                }
            ]
        }
    },
    "file_handlers": [
        {
            "action": "./",
            "accept": {
                "image/*": [".jpg", ".jpeg", ".png", ".gif", ".webp", ".bmp"]
            }
        }
    ]
}
